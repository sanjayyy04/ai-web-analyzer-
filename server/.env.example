PORT=8787
NODE_ENV=development

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Lighthouse device profile: mobile (default) or desktop (closer to DevTools desktop audits)
# LIGHTHOUSE_FORM_FACTOR=desktop

# Comma-separated allowed origins (production). Dev uses Vite proxy.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:8787
